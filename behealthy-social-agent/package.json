{
  "name": "behealthy-social-agent",
  "version": "1.0.0",
  "description": "AI Social Selling Agent for Instituto Be Healthy - Instagram automation with Kommo CRM",
  "scripts": {
    "start:n8n": "n8n start",
    "setup": "node scripts/setup-pipeline.js",
    "import:workflow": "n8n import:workflow --input=workflows/social-instagram-agent.json",
    "validate": "node tests/validate-workflow.js && node tests/e2e-validation.js",
    "test:workflow": "node tests/validate-workflow.js",
    "test:e2e": "node tests/e2e-validation.js",
    "test:pipeline": "node scripts/test-pipeline.js"
  },
  "dependencies": {
    "n8n": "^1.123.25"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
