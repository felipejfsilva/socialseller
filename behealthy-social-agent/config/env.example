# Kommo CRM
KOMMO_BASE_URL=https://felipebhcrm.kommo.com/api/v4
KOMMO_ACCESS_TOKEN=your_kommo_bearer_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Instagram / Meta
INSTAGRAM_VERIFY_TOKEN=your_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password_here
N8N_PORT=5678
WEBHOOK_URL=https://your-domain.com/webhook

# n8n Environment Variables (set these in n8n Settings > Environment Variables)
# These are populated by running: node scripts/setup-pipeline.js
# The output file config/n8n-env-vars.json contains the exact values to paste.
# KOMMO_PIPELINE_ID=<auto-populated by setup script>
# KOMMO_STATUS_NOVO_SEGUIDOR=<auto-populated by setup script>
# KOMMO_STATUS_INTERACAO_INICIAL=<auto-populated by setup script>
# KOMMO_STATUS_QUALIFICACAO=<auto-populated by setup script>
# KOMMO_STATUS_INTERESSE_REAL=<auto-populated by setup script>
# KOMMO_STATUS_ANDREA=<auto-populated by setup script>
# KOMMO_STATUS_THAIS=<auto-populated by setup script>
# KOMMO_STATUS_CONSULTA_AGENDADA=<auto-populated by setup script>

