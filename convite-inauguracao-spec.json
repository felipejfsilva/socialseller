{
  "project": "Convite Inauguração Instituto Be Healthy",
  "description": "Convite pessoal e intransferível para 200 pessoas seletas. Deve transmitir exclusividade, cerimônia, pertencimento e sofisticação. Estética de convite de gala privada — luxo silencioso com presença. O design deve ser tão bonito que os convidados queiram postar nos stories. Funcionar impecavelmente como imagem no WhatsApp.",
  "mood": "Convite de gala beneficente, carta de membro Soho House, inauguração de galeria de arte privada. Luxo suntuoso mas acolhedor. NÃO é panfleto, NÃO é convite de casamento decorado, NÃO é template genérico.",
  "brand": {
    "name": "Instituto Be Healthy",
    "wordmark": "be Healthy",
    "wordmark_style": "O 'be' em caixa baixa, peso light. O 'Healthy' com H maiúsculo, peso medium/semibold. Ambos na mesma linha.",
    "instagram": "@dr.felipefranca"
  },

  "color_palette": {
    "background_primary": {
      "hex": "#F5F0E8",
      "name": "Creme quente",
      "usage": "Fundo principal — evoca papel de alta gramatura, convite físico premium"
    },
    "background_secondary": {
      "hex": "#E8DFD0",
      "name": "Bege areia",
      "usage": "Gradiente sutil opcional no fundo, ou borda interna"
    },
    "gold_accent": {
      "hex": "#C5A46D",
      "name": "Dourado fosco / champagne",
      "usage": "Linhas separadoras, destaques tipográficos, ornamentos mínimos — efeito hot stamping"
    },
    "gold_light": {
      "hex": "#D4B98A",
      "name": "Dourado claro",
      "usage": "Variação mais suave para elementos secundários dourados"
    },
    "dark_wood": {
      "hex": "#5C3D2E",
      "name": "Nogueira escuro",
      "usage": "Alternativa para texto principal quando quiser mais calor que o carvão"
    },
    "text_primary": {
      "hex": "#3A3028",
      "name": "Carvão marrom profundo",
      "usage": "Texto principal — corpo, headline secundária"
    },
    "text_secondary": {
      "hex": "#8C8279",
      "name": "Cinza quente",
      "usage": "Endereço, telefone, detalhes menores"
    },
    "text_tertiary": {
      "hex": "#B0A89E",
      "name": "Cinza claro quente",
      "usage": "Elementos muito sutis se necessário"
    }
  },

  "typography": {
    "headline": {
      "font_family": "Cormorant Garamond",
      "fallback": ["Playfair Display", "DM Serif Display", "Georgia"],
      "weight": "600 (SemiBold)",
      "style": "uppercase",
      "letter_spacing": "0.25em a 0.35em",
      "notes": "Tracking ultra largo para sensação de luxo. Cada letra respira."
    },
    "subheadline": {
      "font_family": "Cormorant Garamond",
      "fallback": ["Playfair Display", "Georgia"],
      "weight": "400 (Regular) ou 300 (Light)",
      "style": "normal (sentence case)",
      "letter_spacing": "0.05em a 0.08em",
      "notes": "Elegante mas legível. Corpo do convite."
    },
    "body": {
      "font_family": "Montserrat",
      "fallback": ["Raleway", "Outfit", "Helvetica Neue"],
      "weight": "300 (Light)",
      "style": "normal",
      "letter_spacing": "0.03em a 0.05em",
      "notes": "Limpa, moderna, boa legibilidade em telas pequenas."
    },
    "details": {
      "font_family": "Montserrat",
      "fallback": ["Raleway", "Outfit"],
      "weight": "300 (Light)",
      "style": "normal ou uppercase para labels",
      "letter_spacing": "0.05em a 0.1em",
      "notes": "Para endereço, telefone, notas de acesso."
    },
    "wordmark": {
      "font_family": "Conforme brand kit Be Healthy",
      "notes": "Usar fonte oficial do logo. 'be' em light, 'Healthy' em medium."
    }
  },

