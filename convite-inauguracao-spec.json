  "design_rules": {
    "general": [
      "ZERO elementos decorativos desnecessários — sem folhas, sem molduras, sem patterns",
      "Tipografia e espaço são os ÚNICOS elementos de design",
      "Linhas douradas finas como ÚNICOS separadores visuais",
      "Todo espaço vazio é INTENCIONAL — comunica luxo",
      "Nenhum texto deve competir com 'CONVITE PESSOAL E INTRANSFERÍVEL'",
      "O design deve parecer um convite físico de gala digitalizado — não um post de rede social"
    ],
    "typography_rules": [
      "NUNCA usar mais de 2 famílias tipográficas (serif + sans-serif)",
      "Headlines em serif (Cormorant Garamond), detalhes em sans-serif (Montserrat)",
      "Letter-spacing largo em TUDO — é a assinatura visual do luxo",
      "Hierarquia clara: headline > corpo > data > endereço > telefone",
      "Uppercase APENAS para: headline, data por extenso, aviso de acesso"
    ],
    "color_rules": [
      "Fundo NUNCA branco puro — sempre creme quente #F5F0E8",
      "Dourado com moderação — separadores e wordmark apenas",
      "Texto principal em carvão #3A3028, NUNCA preto #000000",
      "Detalhes em cinza quente #8C8279, NUNCA cinza frio",
      "Momento emocional (frase de pertencimento) pode usar tom madeira #5C3D2E"
    ],
    "dont": [
      "NÃO descrever arquitetura, decoração ou elementos do espaço",
      "NÃO usar gerúndio no texto",
      "NÃO repetir 'você' — o texto atual tem ZERO 'você'",
      "NÃO adicionar fotos do espaço, ícones ou ilustrações",
      "NÃO usar degradê colorido, sombras ou efeitos 3D",
      "NÃO parecer template genérico de Canva",
      "NÃO usar fontes display/script/handwriting"
    ]
  }
